// ============================================================
//  ПВО от комаров — держатель камеры с кольцом ИК-диодов
//  (вариант D «Комар-Ф»). OpenSCAD, размеры в мм.
//
//  Зачем: в варианте D камера — это ПРИЦЕЛ. Её ось должна быть
//  параллельна лучу лазера и жёстко зафиксирована: любой сдвиг
//  после пристрелки уводит луч. Термоклей этого не держит.
//
//  Что печатается:
//    face  — лицевая панель: окно под объектив, кольцо гнёзд
//            под ИК-диоды 5 мм, лапки под стяжки;
//    cradle— люлька: сажает панель на площадку plate варианта B
//            рядом с лазером, соосно ему;
//    both  — обе детали рядом (по умолчанию).
//
//  ПЕРЕД ПЕЧАТЬЮ замерьте свою камеру и поправьте cam_* ниже.
//  Значения по умолчанию — Raspberry Pi Camera v2/NoIR (25×24 мм).
//
//  Печать: PLA/PETG, слой 0.2, 3 периметра, 25%, без поддержек.
//  Сборка и пристрелка — руководство, глава 13 и «Сборка вариант D».
// ============================================================

// ---- что рендерить: "both" | "face" | "cradle" -------------
part = "both";

// ---- камера ------------------------------------------------
cam_w      = 25.0;   // ширина платы камеры
cam_h      = 24.0;   // высота платы камеры
cam_hole_s = 21.0;   // расстояние между крепёжными отверстиями (квадрат)
cam_hole_d = 2.3;    // отверстия под винты М2
lens_d     = 9.0;    // окно под объектив (с запасом)

// ---- ИК-подсветка ------------------------------------------
led_d      = 5.2;    // диоды 5 мм (+ зазор)
led_n      = 6;      // сколько диодов в кольце
led_ring_r = 11.0;   // радиус кольца от оси объектива
                     // (готовый модуль подсветки — см. ir_module_slot)
ir_module  = false;  // true: вместо кольца — окно под готовую ИК-плату
ir_mod_w   = 38;     // её размеры
ir_mod_h   = 38;

// ---- крепёж панели к стойке --------------------------------
mnt_s      = 16;     // расстояние между винтами М2 (панель <-> стойка)
mnt_d      = 2.3;    // отверстия под М2
slot_h     = 14;     // высота паза в стойке: настройка высоты объектива
                     // ПОСЛЕ печати — двигайте панель, пока ось объектива
                     // не совпадёт с осью лазера, потом затяните

// ---- посадка на площадку -----------------------------------
plate_thick = 3;     // толщина площадки plate из pvo_pan_tilt.scad
laser_axis_z = 14;   // высота оси лазера над площадкой: подгоните
                     // так, чтобы объектив встал на ту же высоту
wall       = 3;
tol        = 0.4;
$fn = 64;

// ============================================================
module ziptie_pair(len = 6, gap = 14) {     // прорези под стяжку
  for (dy = [-gap / 2, gap / 2])
    translate([0, dy]) square([3, len], center = true);
}

// ---- лицевая панель ----------------------------------------
module face() {
  fw = max(cam_w, ir_module ? ir_mod_w : led_ring_r * 2 + led_d + 6) + 2 * wall;
  fh = max(cam_h, ir_module ? ir_mod_h : led_ring_r * 2 + led_d + 6) + 2 * wall;
  difference() {
    linear_extrude(wall) hull()
      for (x = [-fw / 2 + 4, fw / 2 - 4], y = [-fh / 2 + 4, fh / 2 - 4])
        translate([x, y]) circle(r = 4);

    translate([0, 0, -1]) linear_extrude(wall + 2) {
      circle(d = lens_d);                            // окно объектива
      for (dx = [-cam_hole_s / 2, cam_hole_s / 2],   // винты камеры М2
           dy = [-cam_hole_s / 2, cam_hole_s / 2])
        translate([dx, dy]) circle(d = cam_hole_d);
      for (dx = [-mnt_s / 2, mnt_s / 2])              // винты к стойке
        translate([dx, -fh / 2 + wall + 2]) circle(d = mnt_d);
      if (ir_module)                                  // окно под готовую плату
        square([ir_mod_w + tol, ir_mod_h + tol], center = true);
      else
        for (i = [0 : led_n - 1])                     // кольцо гнёзд под диоды
          rotate(360 / led_n * i + 30)
            translate([led_ring_r, 0]) circle(d = led_d);
    }
  }
}

// ---- люлька: панель -> площадка турели ---------------------
module cradle() {
  base_l = 34;                       // вдоль площадки
  base_w = max(cam_w, 26) + 2 * wall;
  h = max(laser_axis_z, slot_h + 8);
  difference() {
    union() {
      linear_extrude(wall)           // подошва
        hull() for (x = [-base_l / 2 + 4, base_l / 2 - 4],
                    y = [-base_w / 2 + 4, base_w / 2 - 4])
          translate([x, y]) circle(r = 4);
      translate([-base_l / 2 + wall, -base_w / 2, 0])   // задняя стойка
        cube([wall, base_w, h + wall]);
      for (dy = [-1, 1])                                // рёбра жёсткости
        translate([-base_l / 2 + wall, dy * (base_w / 2 - wall), 0])
          rotate([0, 0, 0]) cube([base_l * 0.6, wall, h * 0.7]);
    }
    translate([0, 0, -1]) linear_extrude(wall + 2) {
      translate([6, 0]) ziptie_pair(gap = 18);          // стяжками к площадке
      translate([-4, 0]) ziptie_pair(gap = 18);
      for (x = [-8, 4, 12], y = [-base_w / 2 + 5, base_w / 2 - 5])
        translate([x, y]) circle(d = 2.2);              // запасные 2 мм
    }
    // ВЕРТИКАЛЬНЫЕ ПАЗЫ в стойке: высота панели регулируется после печати,
    // чтобы ось объектива встала точно на ось лазера (см. главу 13).
    for (dy = [-mnt_s / 2, mnt_s / 2])
      translate([-base_l / 2 + wall * 1.5, dy, wall + slot_h / 2 + 2])
        hull() for (dz = [-slot_h / 2, slot_h / 2])
          translate([0, 0, dz]) rotate([0, 90, 0])
            cylinder(d = mnt_d + 0.2, h = wall + 4, center = true);
  }
}

// ============================================================
if (part == "face")        face();
else if (part == "cradle") cradle();
else {
  face();
  translate([0, 55, 0]) cradle();
}
